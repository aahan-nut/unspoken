# Public — safe to expose to the browser. The Supabase anon key is meant to
# be public; Row Level Security (not secrecy of this key) is what protects
# user data. See supabase/migrations/ for the RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public — the canonical production URL, used to build absolute links for
# auth email redirects, canonical/OG metadata, etc. Leave unset in local dev;
# it falls back to http://localhost:3000 automatically. In Vercel, set this
# to your production domain (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Server-only — never prefix with NEXT_PUBLIC_, never exposed to the client.
# Used by src/lib/ai/gemini.ts (message generation + safety classification).
GEMINI_API_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never exposed to the client.
# Used by src/lib/geo/places.ts. Requires the "Places API (New)" to be
# enabled on the associated Google Cloud project.
GOOGLE_PLACES_API_KEY=
